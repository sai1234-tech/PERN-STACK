{
  "name": "pern-hrms-workspace",
  "version": "1.0.0",
  "description": "Enterprise PERN (PostgreSQL, Express, React, Node.js) HRMS Stack",
  "private": true,
  "scripts": {
    "docker:up": "docker-compose up --build -d",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:status": "docker-compose ps",
    "docker:seed": "docker exec hrms-backend node scripts/seed_all_missing_enterprise_data.js && docker exec hrms-backend node scripts/seed_comp_perf_ops.js",
    "docker:reset": "docker-compose down -v && docker-compose up --build -d",
    "backend:dev": "npm --prefix Back-End run dev",
    "backend:start": "npm --prefix Back-End start",
    "backend:test": "npm --prefix Back-End test",
    "frontend:dev": "npm --prefix Front-End run dev",
    "frontend:build": "npm --prefix Front-End run build",
    "build": "npm --prefix Front-End run build"
  },
  "keywords": [
    "pern",
    "hrms",
    "postgresql",
    "express",
    "react",
    "node",
    "docker",
    "enterprise"
  ],
  "author": "Quadratic Systems Inc.",
  "license": "ISC"
}

